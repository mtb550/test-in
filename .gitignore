.gradle/
.inspection/
.idea/*
!.idea/inspectionProfiles/
# The spellchecker's project vocabulary, shared for the same reason the
# inspection profile is: otherwise every machine rebuilds the same word list.
!.idea/dictionaries/
# The code style, shared for the same reason: one owner for the wrapping rules
# so every machine formats the same way instead of re-wrapping each other's work.
!.idea/codeStyles/
.intellijPlatform/
.run/
.sandbox/
build/
# Generated report output and scratch scripts, which land wherever they are run.
*.html
*.py
# docs/ is exempt, always. It is a website: its Jekyll includes, layouts and any
# page that has to be hand-written are .html by definition. This exception has
# been deleted twice and both times the file it covered vanished silently - git
# add reports nothing, git status shows nothing, and the site ships broken.
!docs/**/*.html

# Claude Code: share .claude/, keep per-machine overrides local
.claude/settings.local.json
# The sample project is opened by runIde, so the IDE writes its own files into
# it. The sample is the committed part; what an IDE makes of it is not.
samples/automation/.idea/
samples/automation/target/

# Generated automation from a sandbox session. The sample's test source root is
# where Testin writes a generated class, so opening the sample and pressing
# Generate Code drops a real file into a committed folder - and the IDE's Git
# integration stages it. The folder is kept by its .gitkeep; what lands in it is
# not ours.
samples/automation/src/test/java/**/*.java
